# Proveedor activo: "openai" o "google"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
# gpt-4o-mini funciona para chat simple, pero presentMiniApp con bands necesita
# gpt-4o (full) para producir specs ricos de forma consistente.
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-2.5-flash
